---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const AIRBNB_URL = 'https://www.airbnb.co.nz/rooms/958834586847228237';
const CDN = '/images';

const photos = [
  { id: 'f836922c-5043-4103-873f-7205ad07ffcb', alt: 'Hillside Studio exterior and surroundings' },
  { id: 'e812855b-2d62-4146-906c-c40510c767c9', alt: 'Studio interior' },
  { id: 'def82610-c9b3-42d0-a7a3-1bdf47ce475b', alt: 'Living and sleeping area' },
  { id: '3aada3ad-1bfb-42c9-8231-9a43db408d1b', alt: 'Queen bed and bedroom' },
  { id: 'b6dff884-983a-4761-ab38-bad33a29ccaa', alt: 'Ensuite bathroom' },
  { id: '8ccbbd0a-dc92-4266-b7af-d61e353dd607', alt: 'Kitchenette' },
  { id: '70512c44-99bb-49c0-bf76-12115e31d55a', alt: 'Valley view from the studio' },
  { id: '2c623cd8-b492-4ca5-8b4b-94ba7e7800d0', alt: 'Workspace and desk area' },
  { id: '097b4419-eec7-4640-be29-d265e4046a46', alt: 'Studio space' },
];

const amenities = [
  { icon: '🏔️', label: 'Valley view' },
  { icon: '📶', label: 'Fast Wi-Fi · 100 Mbps' },
  { icon: '🖥️', label: '32" HDTV · Netflix · Chromecast' },
  { icon: '🚗', label: 'Free off-street parking' },
  { icon: '💼', label: 'Dedicated workspace' },
  { icon: '🔑', label: 'Self check-in · keypad' },
  { icon: '🍳', label: 'Kitchenette · induction cooktop' },
  { icon: '🛁', label: 'Private ensuite' },
];

const reviews = [
  {
    name: 'Shelley',
    location: 'Canada',
    text: 'Set up in the hills, the view looking out at Wellington was spectacular! The studio had everything you could want and the bed was very comfortable. The hosts were very responsive.',
    stars: 5,
  },
  {
    name: 'Michelle',
    location: 'New Zealand',
    text: 'Step into the studio for the first time and see the view — wonderful. Bed was really comfortable, WiFi was excellent and shower was amazing. Super easy check-in and check-out.',
    stars: 5,
  },
  {
    name: 'Meshach',
    location: 'Minneapolis, USA',
    text: 'Amazingly quiet spot with a great view. A very nice place with a thoughtful design. Windows on both sides allow the air to pass through. Nice local birdsong to wake up to.',
    stars: 5,
  },
];
---

<Layout>
  <!-- Nav -->
  <nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-4 md:px-12"
       style="background: linear-gradient(to bottom, rgba(30,46,38,0.85), transparent); backdrop-filter: blur(2px);">
    <span class="text-white font-heading text-xl tracking-wide">Hillside Studio</span>
    <a
      href={AIRBNB_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium text-white border border-white/60 rounded-full px-5 py-2 hover:bg-white hover:text-[#1e2e26] transition-colors duration-200"
    >
      Book on Airbnb
    </a>
  </nav>

  <!-- Hero -->
  <section class="relative h-screen min-h-[600px] flex items-end">
    <img
      src={`${CDN}/f836922c-5043-4103-873f-7205ad07ffcb.jpg`}
      alt="Hillside Studio — Wellington"
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,35,25,0.80) 0%, rgba(20,35,25,0.20) 60%, transparent 100%);"></div>
    <div class="relative z-10 px-6 pb-16 md:px-16 md:pb-24 max-w-3xl">
      <p class="text-[#b89060] font-heading italic text-lg md:text-xl mb-3">Wellington, New Zealand</p>
      <h1 class="text-white font-heading font-semibold text-5xl md:text-7xl leading-tight mb-5">
        Hillside<br />Studio
      </h1>
      <p class="text-white/80 text-base md:text-lg mb-8 max-w-xl leading-relaxed">
        A calm, stylish retreat nestled on Wrights Hill — with valley views, birdsong, and the city just 10 minutes away.
      </p>
      <a
        href={AIRBNB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-[#3b6b4f] hover:bg-[#2d5440] text-white font-medium rounded-full px-8 py-4 transition-colors duration-200"
      >
        Check availability on Airbnb
      </a>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-[#1e2e26] text-white py-6 px-6">
    <div class="max-w-5xl mx-auto flex flex-wrap justify-center gap-6 md:gap-12 text-center">
      <div>
        <div class="font-heading text-3xl font-semibold text-[#b89060]">4.96★</div>
        <div class="text-sm text-white/60 mt-1">Average rating</div>
      </div>
      <div>
        <div class="font-heading text-3xl font-semibold text-[#b89060]">291</div>
        <div class="text-sm text-white/60 mt-1">Guest reviews</div>
      </div>
      <div>
        <div class="font-heading text-3xl font-semibold text-[#b89060]">Guest</div>
        <div class="text-sm text-white/60 mt-1">Favourite</div>
      </div>
      <div>
        <div class="font-heading text-3xl font-semibold text-[#b89060]">2 guests</div>
        <div class="text-sm text-white/60 mt-1">1 bed · 1 bath</div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="py-20 px-6 md:px-12 max-w-5xl mx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-[#3b6b4f] font-heading italic text-lg mb-3">The space</p>
        <h2 class="font-heading font-semibold text-4xl md:text-5xl leading-tight mb-6 text-[#1e2e26]">
          Your cosy hillside haven
        </h2>
        <p class="text-[#5a5a5a] leading-relaxed mb-5">
          Welcome to Hillside Studio — a calm, stylish retreat nestled on Wrights Hill. Just 10 minutes from Wellington CBD and a short walk from the bus stop, it's the perfect base whether you're here for work or play.
        </p>
        <p class="text-[#5a5a5a] leading-relaxed mb-8">
          Nestled close to the Zealandia wildlife sanctuary, you're likely to hear — and see — Tui, Kererū, and even the occasional Kākā during your stay. The studio sits on a quiet cul-de-sac with off-street parking and easy access.
        </p>
        <a
          href={AIRBNB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-[#3b6b4f] hover:bg-[#2d5440] text-white font-medium rounded-full px-7 py-3.5 transition-colors duration-200"
        >
          Book on Airbnb
        </a>
      </div>
      <div class="relative">
        <img
          src={`${CDN}/e812855b-2d62-4146-906c-c40510c767c9.jpg`}
          alt="Studio interior"
          class="rounded-2xl w-full object-cover shadow-lg aspect-[4/5]"
          loading="lazy"
        />
        <div class="absolute -bottom-4 -left-4 bg-[#1e2e26] text-white rounded-xl px-5 py-3 text-sm">
          <span class="font-heading text-[#b89060] font-semibold">Superhost</span>
          <span class="text-white/60 ml-2">· Jono & Abby</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="py-16 px-6 md:px-12 bg-[#ede5d6]">
    <div class="max-w-6xl mx-auto">
      <p class="text-[#3b6b4f] font-heading italic text-lg mb-2 text-center">The photos</p>
      <h2 class="font-heading font-semibold text-4xl md:text-5xl text-center text-[#1e2e26] mb-10">
        See the space
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
        {photos.slice(0, 6).map((photo, i) => (
          <div class={`overflow-hidden rounded-xl ${i === 0 ? 'col-span-2 md:col-span-1 md:row-span-2' : ''}`}>
            <img
              src={`${CDN}/${photo.id}.jpg`}
              alt={photo.alt}
              class="w-full h-full object-cover aspect-square hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a
          href={AIRBNB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block border-2 border-[#3b6b4f] text-[#3b6b4f] hover:bg-[#3b6b4f] hover:text-white font-medium rounded-full px-7 py-3 transition-colors duration-200"
        >
          View all photos on Airbnb
        </a>
      </div>
    </div>
  </section>

  <!-- Amenities -->
  <section class="py-20 px-6 md:px-12 max-w-5xl mx-auto">
    <p class="text-[#3b6b4f] font-heading italic text-lg mb-2 text-center">What's included</p>
    <h2 class="font-heading font-semibold text-4xl md:text-5xl text-center text-[#1e2e26] mb-12">
      Everything you need
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {amenities.map((item) => (
        <div class="flex flex-col items-center text-center p-5 bg-[#ede5d6] rounded-2xl">
          <span class="text-3xl mb-3">{item.icon}</span>
          <span class="text-sm font-medium text-[#1e2e26] leading-snug">{item.label}</span>
        </div>
      ))}
    </div>
    <p class="text-center text-[#5a5a5a] mt-8 text-sm">
      Plus 25+ more amenities — <a href={AIRBNB_URL} target="_blank" rel="noopener noreferrer" class="text-[#3b6b4f] hover:underline">see the full list on Airbnb</a>
    </p>
  </section>

  <!-- Location -->
  <section class="py-20 px-6 md:px-12 bg-[#1e2e26] text-white">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-[#b89060] font-heading italic text-lg mb-3">Where you'll be</p>
        <h2 class="font-heading font-semibold text-4xl md:text-5xl leading-tight mb-6">
          Wrights Hill,<br />Wellington
        </h2>
        <p class="text-white/70 leading-relaxed mb-5">
          Nestled on the scenic slopes of Wrights Hill, this peaceful neighbourhood offers the perfect blend of nature and convenience. A twenty-minute walk or short drive from Karori's shops and transport links.
        </p>
        <ul class="space-y-2 text-white/70 text-sm">
          <li class="flex items-center gap-2"><span class="text-[#b89060]">→</span> 10 min drive to Wellington CBD</li>
          <li class="flex items-center gap-2"><span class="text-[#b89060]">→</span> Short walk to bus stop</li>
          <li class="flex items-center gap-2"><span class="text-[#b89060]">→</span> Walking distance to Zealandia Sanctuary</li>
          <li class="flex items-center gap-2"><span class="text-[#b89060]">→</span> Quiet cul-de-sac with off-street parking</li>
        </ul>
      </div>
      <div>
        <img
          src={`${CDN}/70512c44-99bb-49c0-bf76-12115e31d55a.jpg`}
          alt="Valley view from Hillside Studio"
          class="rounded-2xl w-full object-cover shadow-xl aspect-[4/3]"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="py-20 px-6 md:px-12 bg-[#f5f0e8]">
    <div class="max-w-5xl mx-auto">
      <p class="text-[#3b6b4f] font-heading italic text-lg mb-2 text-center">What guests say</p>
      <h2 class="font-heading font-semibold text-4xl md:text-5xl text-center text-[#1e2e26] mb-12">
        Loved by guests
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {reviews.map((review) => (
          <div class="bg-white rounded-2xl p-7 shadow-sm">
            <div class="flex gap-0.5 mb-4 text-[#b89060]">
              {'★★★★★'.split('').map(() => <span>★</span>)}
            </div>
            <p class="text-[#1e1e1e] leading-relaxed mb-5 text-sm">"{review.text}"</p>
            <div class="border-t border-[#e8e0d0] pt-4">
              <p class="font-medium text-[#1e2e26] text-sm">{review.name}</p>
              <p class="text-[#5a5a5a] text-xs mt-0.5">{review.location}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a
          href={AIRBNB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#3b6b4f] hover:underline text-sm font-medium"
        >
          Read all 291 reviews on Airbnb →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-28 px-6 text-center overflow-hidden">
    <img
      src={`${CDN}/def82610-c9b3-42d0-a7a3-1bdf47ce475b.jpg`}
      alt="Book Hillside Studio"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-[#1e2e26]/75"></div>
    <div class="relative z-10 max-w-xl mx-auto">
      <h2 class="font-heading font-semibold text-white text-5xl md:text-6xl leading-tight mb-5">
        Ready to book?
      </h2>
      <p class="text-white/75 mb-8 text-lg leading-relaxed">
        Check availability, see exact pricing, and book securely through Airbnb.
      </p>
      <a
        href={AIRBNB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-[#b89060] hover:bg-[#a07a50] text-white font-medium rounded-full px-10 py-4 text-lg transition-colors duration-200"
      >
        Book on Airbnb
      </a>
      <p class="text-white/40 text-xs mt-6">Check-in from 2 pm · Check-out by 11 am · 2 guests max</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-[#141e18] text-white/50 py-8 px-6 text-center text-sm">
    <p class="font-heading text-white text-xl mb-2">Hillside Studio</p>
    <p class="mb-4">Wrights Hill, Wellington, New Zealand</p>
    <a
      href={AIRBNB_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="text-[#b89060] hover:text-[#c4a070] underline text-sm"
    >
      View listing on Airbnb
    </a>
    <p class="mt-6 text-xs text-white/25">Hosted by Jono & Abby · Superhost</p>
  </footer>
</Layout>
